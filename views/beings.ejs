<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%
    const bannerAnnouncements = Array.isArray(announcements) ? announcements : [];
    const beingName = 'Studio North';
    const creatorHandle = '@studionorth';
    const description = 'Founder-approved creative director profile blending photography, short-form video, and voice casting. Each creative director defines their own audition rules, requirements, questions, and conditions before represented beings are considered.';
    const stats = [
      { emoji: '😍', value: 37283 },
      { emoji: '🤩', value: 108097 },
      { emoji: '🥺', value: 347982 }
    ];
    const tags = ['PHOTO', 'VIDEO', 'VOICE', 'CASTING', 'EDITORIAL'];
    const relatedNames = ['IRMA', 'JANE', 'SAVANNAH', 'AUBREY', 'COLLEEN'];
    const cardPositions = ['18% center', '36% center', '58% center', '78% center'];
    const navConfig = {
      brand: {
        href: '/',
        titleText: 'stories By Shews'
      },
      primaryLinks: [
        {
          label: 'Stories',
          href: '/stories',
          children: [
            { label: 'All Stories', href: '/stories' },
            { label: 'Latest Episodes', href: '/stories/latest' },
            { label: 'Founder Figures', href: '/stories/figures' }
          ]
        },
        {
          label: 'Podcast',
          href: '/podcast',
          children: [
            { label: 'Latest Drops', href: '/podcast' },
            { label: 'Narrated Stories', href: '/podcast/narrated-stories' },
            { label: 'Voice Features', href: '/podcast/voice-features' }
          ]
        },
        {
          label: 'Creative Directors',
          href: '/creative-directors',
          description: 'Meet founder-approved creative directors across photography, video, and voice, then follow their rules for auditions and submissions.',
          featureTitle: 'Explore Creative Directors',
          featureBody: 'Browse public CD profiles, portfolio work, and the conditions attached to each audition pathway.',
          children: [
            { label: 'All Creative Directors', href: '/creative-directors' },
            { label: 'Photo & Video CDs', href: '/creative-directors/photo-video' },
            { label: 'Voice CDs', href: '/creative-directors/voice' }
          ]
        },
        {
          label: 'Applications',
          href: '/apply',
          children: [
            { label: 'Become a CD', href: '/apply/creative-director' },
            { label: 'Apply Through a CD', href: '/creative-directors' }
          ]
        },
        { label: 'Blog', href: '/blog' }
      ],
      search: {
        placeholder: 'Search stories, podcast drops, creative directors, or blog posts...'
      },
      actions: {
        link: {
          href: '/signin',
          label: 'Sign In/Sign Up',
          className: 'text-woodsmoke-900 transition hover:text-orchid-700'
        },
        primary: {
          href: '/creative-directors',
          label: 'Explore creative directors',
          className: 'inline-flex items-center justify-center rounded-full bg-orchid-700 px-5 py-3 text-sm font-bold tracking-[0.04em] text-white shadow-2xl transition hover:bg-orchid-600'
        }
      }
    };
    const hasMultipleAnnouncements = bannerAnnouncements.length > 1;
  %>

  <div class="min-h-screen bg-silver-50 pb-12">
    <% if (bannerAnnouncements.length) { %>
      <section class="border-b border-white/10 bg-woodsmoke-950 text-white" data-announcement-banner>
        <div class="mx-auto flex max-w-[1880px] items-center justify-center gap-3 px-5 sm:px-8 lg:px-12">
          <% if (hasMultipleAnnouncements) { %>
            <button
              type="button"
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-white/85 transition sm:h-10 sm:w-10"
              data-announcement-prev
              aria-label="Show previous announcement"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M10.53 5.47a.75.75 0 0 1 0 1.06l-4.72 4.72H20a.75.75 0 0 1 0 1.5H5.81l4.72 4.72a.75.75 0 1 1-1.06 1.06l-6-6a.75.75 0 0 1 0-1.06l6-6a.75.75 0 0 1 1.06 0" clip-rule="evenodd"/></svg>
            </button>
          <% } %>

          <% bannerAnnouncements.forEach(function(announcement, index) { %>
            <a
              href="<%= announcement.link %>"
              class="flex min-h-14 w-full flex-1 items-center justify-center gap-3 py-3 text-center transition duration-200 <%= index === 0 ? 'translate-y-0 opacity-100' : '-translate-y-1.5 opacity-0' %> max-sm:min-h-[4.5rem] max-sm:flex-col max-sm:gap-1 max-sm:py-2"
              data-announcement-item
              <%= index === 0 ? '' : 'hidden' %>
            >
              <span class="text-[0.98rem] font-bold leading-[1.4] tracking-[0.01em]"><%= announcement.message %></span>
              <span class="whitespace-nowrap text-[0.82rem] font-bold uppercase tracking-[0.14em] text-white/78"><%= announcement.cta || 'See more' %></span>
            </a>
          <% }) %>

          <% if (hasMultipleAnnouncements) { %>
            <button
              type="button"
              class="inline-flex h-9 w-9 shrink-0 items-center justify-center text-white/85 transition sm:h-10 sm:w-10"
              data-announcement-next
              aria-label="Show next announcement"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="currentColor" fill-rule="evenodd" d="M13.47 5.47a.75.75 0 0 1 1.06 0l6 6a.75.75 0 0 1 0 1.06l-6 6a.75.75 0 1 1-1.06-1.06l4.72-4.72H4a.75.75 0 0 1 0-1.5h14.19l-4.72-4.72a.75.75 0 0 1 0-1.06" clip-rule="evenodd"/></svg>
            </button>
          <% } %>
        </div>
      </section>
    <% } %>

    <%- include('partials/navbar', { navConfig: navConfig }) %>

    <main class="px-6 pt-10 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-[1880px]">
        <section class="grid gap-8 lg:grid-cols-[minmax(0,1.3fr)_minmax(340px,460px)] lg:items-end">
          <div>
            <div class="flex flex-wrap items-end gap-5 lg:flex-nowrap">
              <h1 class="beings-title font-display text-9xl font-extrabold uppercase leading-[0.82] tracking-[0.04em] text-woodsmoke-900 sm:text-10xl xl:text-11xl">
                <%= beingName %>
              </h1>

              <div class="mb-3 flex items-center gap-3">
                <% ['chat', 'save', 'info'].forEach(function(icon) { %>
                  <button class="flex h-12 w-12 items-center justify-center rounded-md bg-woodsmoke-600 text-white">
                    <% if (icon === 'chat') { %>
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M8 10h8M8 14h5"></path>
                        <path d="M7 19l-3 2v-4a8 8 0 118 8H7z"></path>
                      </svg>
                    <% } %>
                    <% if (icon === 'save') { %>
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M6 3h12a1 1 0 011 1v17l-7-4-7 4V4a1 1 0 011-1z"></path>
                      </svg>
                    <% } %>
                    <% if (icon === 'info') { %>
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 10v6"></path>
                        <path d="M12 7h.01"></path>
                      </svg>
                    <% } %>
                  </button>
                <% }) %>
              </div>
            </div>

            <!-- <div class="mt-2 flex flex-wrap items-center gap-1 text-[15px] text-neutral-700">
              <span class="italic underline">by: <%= creatorHandle %></span>
              <span class="font-bold text-orchid-700">• Featured</span>
            </div> -->
          </div>

          <div class="pb-3">
            <div class="beings-description-fade">
              <p class="beings-description text-lg leading-[1.75] text-woodsmoke-900">
                <%= description %>
              </p>
            </div>

            <div class="mt-3 flex justify-center text-silver-700">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 011.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
              </svg>
            </div>

            <div class="mt-3 flex min-w-0 items-center gap-4 text-orchid-700">
              <button class="inline-flex h-8 w-8 shrink-0 items-center justify-center">
                <svg class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M6 4.75a.75.75 0 011.14-.64l7 4.25a.75.75 0 010 1.28l-7 4.25A.75.75 0 016 13.25v-8.5z"></path>
                </svg>
              </button>

              <div class="flex min-w-0 flex-1 items-center gap-[3px] overflow-hidden">
                <% for (let i = 0; i < 60; i++) { %>
                  <span
                    class="inline-block h-auto w-[4px] shrink-0 rounded-full <%= i < 40 ? 'bg-orchid-700' : 'bg-orchid-200' %>"
                    style="height: <%= 10 + ((i * 7) % 20) %>px;"
                  ></span>
                <% } %>
              </div>

              <span class="shrink-0 text-lg font-bold">00:10</span>
            </div>
          </div>
        </section>

        <section class="mt-8 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
          <% cardPositions.forEach(function(position) { %>
            <article>
              <div class="beings-card overflow-hidden rounded-[4px]" style="background-position: <%= position %>; aspect-ratio: 1 / 1;">
                <div class="h-full w-full bg-[linear-gradient(180deg,rgba(255,255,255,0.08),rgba(0,0,0,0.05))]"></div>
              </div>

              <div class="mt-3 flex flex-wrap items-center gap-5 text-base font-semibold text-woodsmoke-900">
                <!-- <button class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-silver-500 text-woodsmoke-700">+</button> -->
                <% stats.forEach(function(stat) { %>
                  <span class="inline-flex items-center gap-2">
                    <span><%= stat.emoji %></span>
                    <span><%= stat.value.toLocaleString() %></span>
                  </span>
                <% }) %>
              </div>

              <div class="mt-6 flex flex-wrap gap-2">
                <% tags.forEach(function(tag) { %>
                  <span class="inline-flex bg-orchid-200 px-2 py-1 text-sm font-bold uppercase tracking-[0.04em] text-orchid-800"><%= tag %></span>
                <% }) %>
              </div>
            </article>
          <% }) %>
        </section>

        <!-- <section class="mt-10 overflow-hidden">
          <div class="flex flex-col gap-4">
            <% for (let row = 0; row < 2; row++) { %>
              <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
                <% relatedNames.forEach(function(name, index) { %>
                  <div class="flex items-center gap-3">
                    <span class="beings-outline-name font-display text-7xl font-bold uppercase leading-none tracking-[0.08em] text-white sm:text-8xl"><%= relatedNames[(index + row) % relatedNames.length] %></span>
                    <div class="flex items-center gap-2">
                      <% for (let i = 0; i < 4; i++) { %>
                        <div class="h-10 w-10 rounded-[4px] bg-silver-200"></div>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } %>
          </div>
        </section> -->
      </div>
    </main>
  </div>

  <script>
    const announcementBanner = document.querySelector('[data-announcement-banner]');
    const announcementItems = Array.from(document.querySelectorAll('[data-announcement-item]'));
    const previousAnnouncementButton = document.querySelector('[data-announcement-prev]');
    const nextAnnouncementButton = document.querySelector('[data-announcement-next]');
    let currentAnnouncementIndex = 0;
    let announcementRotationInterval = null;
    let isAnnouncementPaused = false;

    function showAnnouncement(index) {
      if (!announcementItems.length) {
        return;
      }

      announcementItems[currentAnnouncementIndex].classList.remove('is-active');
      announcementItems[currentAnnouncementIndex].classList.remove('opacity-100', 'translate-y-0');
      announcementItems[currentAnnouncementIndex].classList.add('opacity-0', '-translate-y-1.5');
      announcementItems[currentAnnouncementIndex].hidden = true;

      currentAnnouncementIndex = (index + announcementItems.length) % announcementItems.length;

      const nextItem = announcementItems[currentAnnouncementIndex];
      nextItem.hidden = false;

      window.requestAnimationFrame(() => {
        nextItem.classList.remove('opacity-0', '-translate-y-1.5');
        nextItem.classList.add('opacity-100', 'translate-y-0');
      });
    }

    function rotateAnnouncement(step) {
      showAnnouncement(currentAnnouncementIndex + step);
    }

    function stopAnnouncementRotation() {
      if (announcementRotationInterval) {
        window.clearInterval(announcementRotationInterval);
        announcementRotationInterval = null;
      }
    }

    function startAnnouncementRotation() {
      if (announcementItems.length <= 1 || isAnnouncementPaused || announcementRotationInterval) {
        return;
      }

      announcementRotationInterval = window.setInterval(() => {
        rotateAnnouncement(1);
      }, 6000);
    }

    function pauseAnnouncements() {
      isAnnouncementPaused = true;
      stopAnnouncementRotation();
    }

    function resumeAnnouncements() {
      isAnnouncementPaused = false;
      startAnnouncementRotation();
    }

    if (announcementItems.length > 1) {
      startAnnouncementRotation();

      if (announcementBanner) {
        announcementBanner.addEventListener('mouseenter', pauseAnnouncements);
        announcementBanner.addEventListener('mouseleave', resumeAnnouncements);
      }

      if (previousAnnouncementButton) {
        previousAnnouncementButton.addEventListener('click', () => {
          pauseAnnouncements();
          rotateAnnouncement(-1);
        });
      }

      if (nextAnnouncementButton) {
        nextAnnouncementButton.addEventListener('click', () => {
          pauseAnnouncements();
          rotateAnnouncement(1);
        });
      }
    }
  </script>
</body>
</html>
