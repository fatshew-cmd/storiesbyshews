<%- include('partials/shell-start') %>

<section class="border-b border-silver-200 bg-white p-4">
  <div class="flex items-end justify-between gap-4">
    <div>
      <%- include('partials/page-header', {
        eyebrow: 'Publishing',
        titleText: 'Profiles',
        description: 'Create, edit, and maintain figure and represented-being records and related media.'
      }) %>
    </div>
    <% if (forms.persona.id) { %>
      <a href="/admin/personas" class="text-sm font-semibold text-orchid-700 underline">Clear edit mode</a>
    <% } %>
  </div>

  <form action="/admin/personas/save" method="post" class="mt-6 grid gap-4 md:grid-cols-2">
    <input type="hidden" name="id" value="<%= forms.persona.id %>" />
    <label class="admin-field"><span>Name</span><input type="text" name="name" required value="<%= forms.persona.name %>" class="admin-input" /></label>
    <label class="admin-field"><span>Profile type</span><select name="personaType" class="admin-input"><% options.personaTypes.forEach(function(option) { %><option value="<%= option %>" <%= forms.persona.personaType === option ? 'selected' : '' %>><%= options.personaTypeLabels[option] || option %></option><% }) %></select></label>
    <label class="admin-field"><span>String ID</span><input type="text" name="stringId" value="<%= forms.persona.stringId %>" class="admin-input" /></label>
    <label class="admin-field"><span>Slug</span><input type="text" name="slug" value="<%= forms.persona.slug %>" class="admin-input" /></label>
    <label class="admin-field md:col-span-2"><span>Tagline</span><input type="text" name="tagline" value="<%= forms.persona.tagline %>" class="admin-input" /></label>
    <label class="admin-field md:col-span-2"><span>Short bio</span><textarea name="shortBio" class="admin-textarea"><%= forms.persona.shortBio %></textarea></label>
    <label class="admin-field md:col-span-2"><span>Long bio</span><textarea name="longBio" class="admin-textarea min-h-[180px]"><%= forms.persona.longBio %></textarea></label>
    <label class="admin-field"><span>Tags</span><input type="text" name="tags" value="<%= forms.persona.tags %>" class="admin-input" /></label>
    <label class="admin-field"><span>Search aliases</span><input type="text" name="searchAliases" value="<%= forms.persona.searchAliases %>" class="admin-input" /></label>
    <label class="admin-field"><span>Hero image URL</span><input type="text" name="heroImageUrl" value="<%= forms.persona.heroImageUrl %>" class="admin-input" /></label>
    <label class="admin-field"><span>Hero image alt</span><input type="text" name="heroImageAlt" value="<%= forms.persona.heroImageAlt %>" class="admin-input" /></label>
    <label class="admin-field"><span>Gallery image URLs</span><textarea name="galleryImageUrls" class="admin-textarea"><%= forms.persona.galleryImageUrls %></textarea></label>
    <label class="admin-field"><span>Gallery image alts</span><textarea name="galleryImageAlts" class="admin-textarea"><%= forms.persona.galleryImageAlts %></textarea></label>
    <label class="admin-field"><span>Tease audio URL</span><input type="text" name="teaseAudioUrl" value="<%= forms.persona.teaseAudioUrl %>" class="admin-input" /></label>
    <label class="admin-field"><span>Audio duration (seconds)</span><input type="number" min="0" name="teaseAudioDurationSeconds" value="<%= forms.persona.teaseAudioDurationSeconds %>" class="admin-input" /></label>
    <label class="admin-field md:col-span-2"><span>Status</span><select name="status" class="admin-input"><% options.statuses.forEach(function(option) { %><option value="<%= option %>" <%= forms.persona.status === option ? 'selected' : '' %>><%= option %></option><% }) %></select></label>
    <div class="md:col-span-2"><button type="submit" class="admin-primary-button"><%= forms.persona.id ? 'Update profile' : 'Create profile' %></button></div>
  </form>

  <div class="mt-8 overflow-hidden border border-silver-200">
    <div class="admin-table-head admin-table-head-wide">
      <span>Name</span><span>Type</span><span>Status</span><span>Aliases</span><span></span>
    </div>
    <% personas.forEach(function(item) { %>
      <div class="admin-table-row admin-table-row-wide">
        <span class="font-semibold text-woodsmoke-900"><%= item.name %></span>
        <span class="capitalize text-woodsmoke-700"><%= options.personaTypeLabels[item.personaType] || item.personaType %></span>
        <span><span class="inline-flex rounded-md px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] <%= statusClasses[item.status] || statusClasses.draft %>"><%= item.status %></span></span>
        <span class="text-woodsmoke-700"><%= (item.searchAliases || []).join(', ') || 'None' %></span>
        <span class="text-right"><a href="/admin/personas?editPersona=<%= item._id %>" class="text-sm font-semibold text-orchid-700 underline">Edit</a></span>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/shell-end') %>
