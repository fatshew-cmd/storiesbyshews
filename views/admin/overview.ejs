<%- include('partials/shell-start') %>

<section class="border-b border-silver-200 bg-white p-4">
  <%- include('partials/page-header', {
    eyebrow: 'Dashboard',
    titleText: 'Overview',
    description: 'Quick snapshot of the founder console and recent publishing activity.'
  }) %>

  <div class="mt-4 grid gap-0 border border-silver-200 sm:grid-cols-2 xl:grid-cols-4">
    <% overviewCards.forEach(function(card) { %>
      <article class="border-r border-silver-200 p-4 last:border-r-0 xl:[&:nth-child(4)]:border-r-0">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-silver-600"><%= card.label %></p>
        <p class="mt-3 font-display text-4xl font-bold leading-none text-woodsmoke-900"><%= card.value %></p>
        <p class="mt-3 text-sm text-woodsmoke-700"><%= card.hint %></p>
      </article>
    <% }) %>
  </div>
</section>

<section class="border-b border-silver-200 bg-white p-4">
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-silver-600">Recent Updates</p>

  <div class="mt-4 overflow-hidden border border-silver-200">
    <div class="admin-table-head">
      <span>Item</span>
      <span>Type</span>
      <span>Status</span>
      <span>Updated</span>
    </div>

    <% recentUpdates.forEach(function(item) { %>
      <div class="admin-table-row">
        <span class="font-semibold text-woodsmoke-900"><%= item.title %></span>
        <span class="capitalize text-woodsmoke-700"><%= item.kind %></span>
        <span>
          <span class="inline-flex rounded-md px-3 py-1 text-xs font-bold uppercase tracking-[0.08em] <%= statusClasses[item.status] || statusClasses.draft %>">
            <%= item.status %>
          </span>
        </span>
        <span class="text-woodsmoke-700"><%= new Date(item.updatedAt).toLocaleString() %></span>
      </div>
    <% }) %>
  </div>
</section>

<%- include('partials/shell-end') %>
