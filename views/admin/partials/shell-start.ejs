    <main class="min-w-0 p-0">
      <% if (notice) { %>
        <div class="mb-5 border px-4 py-3 text-sm font-medium <%= noticeTone === 'error' ? 'border-[#f2b2b2] bg-[#fff3f3] text-[#8c1c1c]' : 'border-[#c6ebd0] bg-[#eefbf2] text-[#166534]' %>">
          <%= notice %>
        </div>
      <% } %>

      <% if (usingFallbackAccessKey) { %>
        <div class="mb-5 border border-orchid-200 bg-orchid-50 px-4 py-4 text-sm leading-6 text-orchid-900">
          This panel is using the fallback local access key. Set <code>ADMIN_ACCESS_KEY</code> in <code>.env</code> before production use.
        </div>
      <% } %>

      <script>
        (function () {
          const url = new URL(window.location.href);
          const notice = (url.searchParams.get('notice') || '').trim().toLowerCase();

          if (notice === 'signed in') {
            url.searchParams.delete('notice');
            url.searchParams.delete('tone');
            window.history.replaceState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
          }
        })();
      </script>
