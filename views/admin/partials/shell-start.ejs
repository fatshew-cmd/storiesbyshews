<body class="min-h-screen bg-white text-woodsmoke-900">
  <div class="min-h-screen lg:grid lg:grid-cols-[280px_minmax(0,1fr)]">
    <aside class="lg:min-h-screen">
      <div class="admin-sidebar-panel">
        <div>
          <div class="flex items-center gap-3">
            <img
              src="/assets/Screenshot 2026-05-17 144029.png"
              alt="Stories By Shews logo"
              class="h-10 w-10 object-cover"
            />
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-silver-500">Stories By Shews</p>
              <h1 class="mt-1 text-base font-semibold text-woodsmoke-900">Founder Console</h1>
            </div>
          </div>

          <nav class="mt-8 space-y-6">
