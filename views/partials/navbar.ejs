<%
  const nav = typeof navConfig === 'object' && navConfig ? navConfig : {};
  const brand = nav.brand || {};
  const actions = nav.actions || {};
  const primaryLinks = Array.isArray(nav.primaryLinks) && nav.primaryLinks.length
    ? nav.primaryLinks
    : [
        {
          label: 'Stories',
          href: '/stories',
          children: [
            { label: 'All Stories', href: '/stories' },
            { label: 'Latest Episodes', href: '/stories/latest' },
            { label: 'Founder Figures', href: '/stories/figures' }
          ]
        },
        {
          label: 'Podcast',
          href: '/podcast',
          children: [
            { label: 'Latest Drops', href: '/podcast' },
            { label: 'Narrated Stories', href: '/podcast/narrated-stories' },
            { label: 'Voice Features', href: '/podcast/voice-features' }
          ]
        },
        {
          label: 'Creative Directors',
          href: '/creative-directors',
          description: 'Meet founder-approved creative directors across photography, video, and voice, then follow their rules for auditions and submissions.',
          featureTitle: 'Explore Creative Directors',
          featureBody: 'Browse public CD profiles, portfolio work, and the conditions attached to each audition pathway.',
          children: [
            { label: 'All Creative Directors', href: '/creative-directors' },
            { label: 'Photo & Video CDs', href: '/creative-directors/photo-video' },
            { label: 'Voice CDs', href: '/creative-directors/voice' }
          ]
        },
        {
          label: 'Applications',
          href: '/apply',
          children: [
            { label: 'Become a CD', href: '/apply/creative-director' },
            { label: 'Apply Through a CD', href: '/creative-directors' }
          ]
        },
        { label: 'Blog', href: '/blog' }
      ];
  const search = nav.search || {};
  const brandText = 'StoriesByShews';
  const searchLabel = search.buttonLabel || 'Search';
  const searchPlaceholder = search.placeholder || 'Search stories, podcast drops, creative directors...';
  const logoSrc = brand.logoSrc || '/assets/Screenshot 2026-05-17 144029.png';
  const accountLink = actions.link || {
    href: '/signin',
    label: 'Sign In/Sign Up',
    className: 'text-woodsmoke-900 transition hover:text-orchid-700'
  };
  const primaryAction = actions.primary || {
    href: '/creative-directors',
    label: 'Explore creative directors',
    className: 'inline-flex items-center justify-center rounded-full bg-orchid-700 px-5 py-3 text-sm font-bold text-white shadow-2xl transition hover:bg-orchid-600'
  };
%>

<header class="<%= nav.wrapperClass || 'px-5 pt-6 sm:px-8 lg:px-12' %>">
  <div class="<%= nav.containerClass || 'mx-auto flex min-h-20 max-w-[1880px] flex-col gap-5 border-b border-silver-200 py-5 lg:grid lg:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] lg:items-center lg:gap-8' %>">
    <div class="<%= nav.brandWrapClass || 'flex items-center justify-between gap-6 lg:min-w-0 lg:justify-self-start' %>">
      <a href="<%= brand.href || '/' %>" class="<%= brand.linkClass || 'flex items-center gap-3 text-woodsmoke-900' %>">
        <img
          src="<%= logoSrc %>"
          alt="Stories By Shews logo"
          class="<%= brand.logoClass || 'h-11 w-11 shrink-0 rounded-full object-cover sm:h-12 sm:w-12' %>"
        />
        <span class="<%= brand.titleClass || 'font-display text-2xl font-bold leading-none text-woodsmoke-900 sm:text-3xl' %>"><%= brandText %></span>
      </a>

      <% if (actions.mobilePrimary) { %>
        <a href="<%= actions.mobilePrimary.href || '/' %>" class="<%= actions.mobilePrimary.className || 'rounded-full border border-woodsmoke-900 px-4 py-2 text-sm font-semibold text-woodsmoke-900 lg:hidden' %>">
          <%= actions.mobilePrimary.label %>
        </a>
      <% } %>
    </div>

    <div class="<%= nav.centerWrapClass || 'relative flex flex-wrap items-center justify-center gap-3 lg:justify-center lg:gap-2' %>">
      <% primaryLinks.forEach(function(link) { %>
        <% const children = Array.isArray(link.children) ? link.children : []; %>
        <% if (children.length) { %>
          <%
            const columnCount = children.length <= 4 ? 1 : children.length <= 8 ? 2 : 3;
            const chunkSize = Math.ceil(children.length / columnCount);
            const childColumns = [];
            for (let index = 0; index < children.length; index += chunkSize) {
              childColumns.push(children.slice(index, index + chunkSize));
            }
            const menuDescription = link.description || ('Explore ' + link.label.toLowerCase() + ' through curated drops, featured stories, and collector favorites.');
            const featureTitle = link.featureTitle || (children[0] && children[0].label) || link.label;
            const featureBody = link.featureBody || ('Start with ' + featureTitle.toLowerCase() + ' and move through the latest additions in ' + link.label.toLowerCase() + '.');
          %>
          <div class="site-nav-group">
            <button
              type="button"
              class="site-nav-trigger inline-flex items-center gap-2 rounded-full px-3 py-2 text-base font-medium text-woodsmoke-900 transition hover:text-orchid-700"
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span><%= link.label %></span>
              <svg class="h-4 w-4 text-silver-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 011.08 1.04l-4.25 4.51a.75.75 0 01-1.08 0l-4.25-4.51a.75.75 0 01.02-1.06z" clip-rule="evenodd"></path>
              </svg>
            </button>

            <div class="site-nav-dropdown absolute top-full z-50 mt-3 rounded-md border border-silver-200 bg-white p-5 shadow-2xl sm:p-6">
              <div class="grid gap-6 lg:grid-cols-[240px_minmax(0,1fr)_240px] lg:gap-8">
                <div class="border-b border-silver-200 pb-5 lg:border-b-0 lg:border-r lg:pb-0 lg:pr-8">
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-silver-600">Explore</p>
                  <a href="<%= link.href || '#' %>" class="mt-3 inline-flex items-center gap-2 font-display text-3xl font-bold text-woodsmoke-900">
                    <span><%= link.label %></span>
                    <svg class="h-5 w-5 text-orchid-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                      <path d="M5 12h14"></path>
                      <path d="m13 5l7 7l-7 7"></path>
                    </svg>
                  </a>
                  <p class="mt-4 max-w-[24ch] text-sm leading-6 text-woodsmoke-700">
                    <%= menuDescription %>
                  </p>
                </div>

                <div class="grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
                  <% childColumns.forEach(function(column, columnIndex) { %>
                    <div class="space-y-3">
                      <p class="text-xs font-semibold uppercase tracking-[0.14em] text-silver-600">
                        <%= columnIndex === 0 ? 'Featured Paths' : 'More To Explore' %>
                      </p>
                      <% column.forEach(function(child) { %>
                        <a href="<%= child.href || '#' %>" class="block rounded-md px-4 py-3 text-base font-medium text-woodsmoke-900 transition hover:bg-silver-50 hover:text-orchid-700">
                          <%= child.label %>
                        </a>
                      <% }) %>
                    </div>
                  <% }) %>
                </div>

                <a href="<%= (children[0] && children[0].href) || link.href || '#' %>" class="rounded-md border border-silver-200 bg-silver-50 p-5 transition hover:border-orchid-200 hover:bg-white">
                  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-silver-600">Featured</p>
                  <h3 class="mt-3 font-display text-2xl font-bold leading-none text-woodsmoke-900">
                    <%= featureTitle %>
                  </h3>
                  <p class="mt-4 text-sm leading-6 text-woodsmoke-700">
                    <%= featureBody %>
                  </p>
                  <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-orchid-700">
                    <span>Open collection</span>
                    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                      <path d="M5 12h14"></path>
                      <path d="m13 5l7 7l-7 7"></path>
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          </div>
        <% } else { %>
          <a href="<%= link.href || '#' %>" class="inline-flex rounded-full px-3 py-2 text-base font-medium text-woodsmoke-900 transition hover:text-orchid-700">
            <%= link.label %>
          </a>
        <% } %>
      <% }) %>
    </div>

    <div class="<%= nav.rightWrapClass || 'flex flex-wrap items-center gap-4 lg:min-w-0 lg:justify-self-end' %>">
      <button
        type="button"
        class="<%= search.buttonClass || 'inline-flex h-11 w-11 items-center justify-center rounded-full border border-silver-200 text-woodsmoke-900 transition hover:border-orchid-700 hover:text-orchid-700' %>"
        data-search-open
        aria-controls="site-search-overlay"
        aria-expanded="false"
        aria-label="<%= searchLabel %>"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20L17 17"></path>
        </svg>
      </button>

      <a href="<%= accountLink.href || '/' %>" class="<%= accountLink.className %>"><%= accountLink.label %></a>

      <% if (primaryAction) { %>
        <a href="<%= primaryAction.href || '/' %>" class="<%= primaryAction.className %>">
          <%= primaryAction.label %>
        </a>
      <% } %>
    </div>
  </div>
</header>

<div id="site-search-overlay" class="site-search-overlay fixed inset-0 z-50 hidden items-start justify-center px-5 pt-24 sm:px-8" hidden>
  <button type="button" class="site-search-backdrop absolute inset-0 bg-woodsmoke-950/40" data-search-close aria-label="Close search"></button>
  <div class="site-search-panel relative z-10 w-full max-w-[720px] rounded-[28px] border border-silver-200 bg-white p-5 shadow-2xl sm:p-6">
    <div class="flex items-center gap-3 rounded-full border border-silver-200 bg-silver-50 px-4 py-3">
      <svg class="h-5 w-5 shrink-0 text-silver-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M20 20L17 17"></path>
      </svg>
      <input
        type="search"
        placeholder="<%= searchPlaceholder %>"
        class="w-full bg-transparent text-base text-woodsmoke-900 placeholder:text-silver-500 focus:outline-none"
        data-search-input
      />
      <button type="button" class="text-sm font-medium text-silver-600 transition hover:text-woodsmoke-900" data-search-close>
        Close
      </button>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <% ['Stories', 'Podcast', 'Creative Directors', 'Applications', 'Blog'].forEach(function(tag) { %>
        <button type="button" class="rounded-full bg-silver-50 px-3 py-2 text-sm font-medium text-woodsmoke-800 transition hover:bg-orchid-200 hover:text-orchid-800">
          <%= tag %>
        </button>
      <% }) %>
    </div>
  </div>
</div>

<script>
  (function () {
    const searchOverlay = document.getElementById('site-search-overlay');
    if (!searchOverlay) {
      return;
    }

    const openButtons = Array.from(document.querySelectorAll('[data-search-open]'));
    const closeButtons = Array.from(document.querySelectorAll('[data-search-close]'));
    const searchInput = searchOverlay.querySelector('[data-search-input]');

    function openSearch() {
      searchOverlay.hidden = false;
      searchOverlay.classList.remove('hidden');
      searchOverlay.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      openButtons.forEach((button) => button.setAttribute('aria-expanded', 'true'));

      window.setTimeout(() => {
        if (searchInput) {
          searchInput.focus();
        }
      }, 0);
    }

    function closeSearch() {
      searchOverlay.hidden = true;
      searchOverlay.classList.remove('flex');
      searchOverlay.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
      openButtons.forEach((button) => button.setAttribute('aria-expanded', 'false'));
    }

    openButtons.forEach((button) => {
      button.addEventListener('click', openSearch);
    });

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeSearch);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !searchOverlay.hidden) {
        closeSearch();
      }
    });
  })();
</script>
